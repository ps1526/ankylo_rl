<mujoco model="ankylosaurus">

  <!--
    Ankylosaurus magniventris — MuJoCo MJCF body model

    PALEOBIOLOGICAL PARAMETERS:
      Body mass:       ~4,800–6,000 kg  (Arbour & Currie 2013)
      Hip height:      ~1.7 m           (limb bone measurements)
      Max speed:       8–13 km/h        (trackway + bone stress limits)
      CoM height:      ~40% body height (osteoderm mass distribution)
      Tail club force: 7,281–14,360 N   (Arbour 2009 FEA, CT scan)
      Gait:            wide-gauge quadruped (hip socket fossil geometry)

    MJCF SCALE: 1 unit = 1 meter

    ACTUATED DOF: 28
      Neck + head:  3
      Legs (×4):   20  (hip_abduct + hip_flex + hip_rotate + knee + ankle)
      Tail:         5  (base_lat + base_dv + mid_lat + mid_dv + handle_lat)

    UNACTUATED: 6 DOF freejoint (root position + orientation)

    KEY DIFFERENCES FROM BRACHIOSAURUS (mesozoic-labs):
      - Legs attach at y=±0.75 (wide-gauge), not columnar near y=0
      - Hip height ~1.2m (vs 3m+ in brachio)
      - Body box wider than tall (inverted proportions)
      - Short stiff neck (3 DOF) vs long neck (6 DOF)
      - Tail has 3-segment club: handle lateral-only per Arbour 2009
      - Osteoderm passive geoms shift CoM downward
      - Higher gear ratios (~5x per-leg load vs brachio)
  -->

  <compiler angle="degree" inertiafromgeom="true" autolimits="true"/>

  <option
    timestep="0.005"
    iterations="50"
    solver="PGS"
    gravity="0 0 -9.81"
    integrator="RK4"
  />

  <size nstack="3000000"/>

  <default>
    <joint limited="true" damping="1.0" armature="0.02" frictionloss="0.1"/>
    <geom contype="1" conaffinity="1" condim="3" friction="1.2 0.1 0.1"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>

    <!-- Armor: contributes to mass/CoM, no self-collision -->
    <default class="armor">
      <geom contype="2" conaffinity="0" rgba="0.38 0.33 0.22 1"/>
    </default>

    <!-- Legs: skin color -->
    <default class="leg">
      <geom rgba="0.50 0.42 0.28 1"/>
    </default>

    <!--
      Club: contype=4, conaffinity=4.
      IMPORTANT: Set T-rex body geoms to conaffinity=4 in the multi-agent
      scene so club strikes register against predator bodies only.
      This prevents the club from colliding with the ground every step.
    -->
    <default class="club">
      <geom contype="4" conaffinity="4" rgba="0.72 0.68 0.58 1" friction="0.8 0.1 0.1"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.65 0.78 0.55" rgb2="0.35 0.52 0.28"
             width="256" height="256"/>
    <texture type="2d" name="ground_tex" builtin="checker"
             rgb1="0.48 0.58 0.38" rgb2="0.38 0.48 0.28"
             width="512" height="512"/>
    <material name="ground_mat" texture="ground_tex" texrepeat="6 6" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light name="sun" pos="0 0 12" dir="0 -0.4 -1"
           diffuse="0.95 0.92 0.85" specular="0.2 0.2 0.2"
           directional="true" castshadow="true"/>
    <geom name="floor" type="plane" size="30 30 0.1"
          material="ground_mat" contype="1" conaffinity="1"/>

    <!--
      TORSO
      Dimensions: 2.8m long × 1.5m wide × 0.8m tall (half-sizes in MJCF)
      Mass 3000 kg: muscle, viscera, skeleton core
      pos z=1.30: torso centre ~1.3m above ground; feet reach ground at rest
    -->
    <body name="torso" pos="0 0 1.30">
      <freejoint name="root"/>

      <!-- IMU site at torso centre for sensor readings -->
      <site name="imu" pos="0 0 0" size="0.01"/>

      <geom name="torso_main" type="box"
            size="1.40 0.75 0.40" pos="0 0 0"
            mass="3000" rgba="0.52 0.44 0.30 1"/>

      <!-- Shoulder girdle: pectoral region wide in ankylosaurs -->
      <geom name="shoulder_girdle" type="box"
            size="0.35 0.85 0.32" pos="0.80 0 -0.04"
            mass="200" rgba="0.50 0.42 0.28 1"/>

      <!-- Hip girdle: broad horizontal ilia -->
      <geom name="hip_girdle" type="box"
            size="0.30 0.80 0.28" pos="-0.80 0 -0.06"
            mass="200" rgba="0.50 0.42 0.28 1"/>

      <!-- ================================================ -->
      <!-- OSTEODERM ARMOR                                  -->
      <!-- Passive geoms — shift CoM DOWN to ~40% height   -->
      <!-- contype=2 / conaffinity=0: no self-collision     -->
      <!-- ================================================ -->

      <!-- Lateral paravertebral rows -->
      <geom class="armor" name="os_R1_L" type="box" size="0.13 0.09 0.07" pos=" 0.85  0.52 0.44" mass="18"/>
      <geom class="armor" name="os_R1_R" type="box" size="0.13 0.09 0.07" pos=" 0.85 -0.52 0.44" mass="18"/>
      <geom class="armor" name="os_R2_L" type="box" size="0.15 0.09 0.08" pos=" 0.40  0.56 0.45" mass="22"/>
      <geom class="armor" name="os_R2_R" type="box" size="0.15 0.09 0.08" pos=" 0.40 -0.56 0.45" mass="22"/>
      <geom class="armor" name="os_R3_L" type="box" size="0.15 0.09 0.08" pos="-0.15  0.56 0.45" mass="22"/>
      <geom class="armor" name="os_R3_R" type="box" size="0.15 0.09 0.08" pos="-0.15 -0.56 0.45" mass="22"/>
      <geom class="armor" name="os_R4_L" type="box" size="0.13 0.09 0.07" pos="-0.65  0.52 0.44" mass="18"/>
      <geom class="armor" name="os_R4_R" type="box" size="0.13 0.09 0.07" pos="-0.65 -0.52 0.44" mass="18"/>

      <!-- Midline keel plates -->
      <geom class="armor" name="os_mid1" type="box" size="0.11 0.07 0.10" pos=" 0.90 0 0.46" mass="14"/>
      <geom class="armor" name="os_mid2" type="box" size="0.13 0.07 0.12" pos=" 0.40 0 0.48" mass="18"/>
      <geom class="armor" name="os_mid3" type="box" size="0.13 0.07 0.12" pos="-0.15 0 0.48" mass="18"/>
      <geom class="armor" name="os_mid4" type="box" size="0.11 0.07 0.10" pos="-0.65 0 0.46" mass="14"/>

      <!-- Lateral flank scutes -->
      <geom class="armor" name="os_flank_L1" type="box" size="0.10 0.06 0.04" pos=" 0.60  0.73 0.36" mass="8"/>
      <geom class="armor" name="os_flank_R1" type="box" size="0.10 0.06 0.04" pos=" 0.60 -0.73 0.36" mass="8"/>
      <geom class="armor" name="os_flank_L2" type="box" size="0.10 0.06 0.04" pos="-0.20  0.73 0.36" mass="8"/>
      <geom class="armor" name="os_flank_R2" type="box" size="0.10 0.06 0.04" pos="-0.20 -0.73 0.36" mass="8"/>

      <!-- ============================================== -->
      <!-- NECK                                          -->
      <!-- Short, stiff, nearly horizontal               -->
      <!-- 2 DOF: pitch (−20°→+30°) + yaw (±40°)        -->
      <!-- ============================================== -->
      <body name="neck" pos="1.40 0 0.08">
        <joint name="neck_pitch" type="hinge" axis="0 1 0"
               range="-20 30" damping="6.0" stiffness="20"/>
        <joint name="neck_yaw"   type="hinge" axis="0 0 1"
               range="-40 40" damping="6.0" stiffness="15"/>
        <geom name="neck_geom" type="capsule"
              fromto="0 0 0  0.42 0 0.04"
              size="0.20" mass="120" rgba="0.50 0.42 0.28 1"/>
        <geom class="armor" name="os_neck_top" type="box"
              size="0.18 0.12 0.05" pos="0.20 0 0.22" mass="12"/>

        <!-- ========================================== -->
        <!-- HEAD                                      -->
        <!-- 1 DOF: head_pitch (−15°→+20°)            -->
        <!-- Broad flat skull with squamosal horns     -->
        <!-- ========================================== -->
        <body name="head" pos="0.42 0 0.04">
          <joint name="head_pitch" type="hinge" axis="0 1 0"
                 range="-15 20" damping="3.0" stiffness="10"/>
          <geom name="skull" type="box"
                size="0.32 0.20 0.16" pos="0.18 0 0"
                mass="75" rgba="0.48 0.40 0.26 1"/>
          <geom name="beak" type="box"
                size="0.08 0.22 0.08" pos="0.48 0 -0.04"
                mass="20" rgba="0.42 0.36 0.22 1"/>
          <geom class="armor" name="skull_scute" type="box"
                size="0.28 0.17 0.05" pos="0.18 0 0.18" mass="22"/>
          <!-- Squamosal horns: diagnostic Ankylosaurus feature -->
          <geom class="armor" name="horn_L" type="capsule"
                fromto="0 0.18 0.08  -0.08 0.26 0.12" size="0.04" mass="6"/>
          <geom class="armor" name="horn_R" type="capsule"
                fromto="0 -0.18 0.08 -0.08 -0.26 0.12" size="0.04" mass="6"/>
          <site name="head_site" pos="0.18 0 0" size="0.05"/>
        </body>
      </body>

      <!-- ============================================== -->
      <!-- TAIL SYSTEM                                   -->
      <!-- 3 segments + rigid club knob                 -->
      <!--                                              -->
      <!-- CRITICAL CONSTRAINT (Arbour 2009):           -->
      <!--   Handle vertebrae are ossified+interlocked  -->
      <!--   → lateral swing ONLY on handle joint       -->
      <!--   → NO dorsoventral DOF distally             -->
      <!--                                              -->
      <!-- Club impact force: 7,281–14,360 N [FEA]     -->
      <!-- ============================================== -->

      <!-- Tail Base: 2 DOF, most flexible -->
      <body name="tail_base" pos="-1.40 0 -0.05">
        <joint name="tail_base_lat" type="hinge" axis="0 0 1"
               range="-35 35" damping="4.0" stiffness="8"/>
        <joint name="tail_base_dv"  type="hinge" axis="0 1 0"
               range="-18 18" damping="4.0" stiffness="8"/>
        <geom name="tail_base_geom" type="capsule"
              fromto="0 0 0  -0.65 0 -0.06"
              size="0.19" mass="90" rgba="0.50 0.42 0.28 1"/>
        <geom class="armor" name="os_tail_base_L" type="box"
              size="0.10 0.06 0.05" pos="-0.25  0.16 0.17" mass="8"/>
        <geom class="armor" name="os_tail_base_R" type="box"
              size="0.10 0.06 0.05" pos="-0.25 -0.16 0.17" mass="8"/>

        <!-- Tail Mid: 2 DOF, progressively stiffer -->
        <body name="tail_mid" pos="-0.65 0 -0.06">
          <joint name="tail_mid_lat" type="hinge" axis="0 0 1"
                 range="-28 28" damping="3.0" stiffness="12"/>
          <joint name="tail_mid_dv"  type="hinge" axis="0 1 0"
                 range="-12 12" damping="3.0" stiffness="12"/>
          <geom name="tail_mid_geom" type="capsule"
                fromto="0 0 0  -0.60 0 -0.04"
                size="0.14" mass="55" rgba="0.50 0.42 0.28 1"/>
          <geom class="armor" name="os_tail_mid_L" type="box"
                size="0.08 0.05 0.04" pos="-0.25  0.13 0.13" mass="6"/>
          <geom class="armor" name="os_tail_mid_R" type="box"
                size="0.08 0.05 0.04" pos="-0.25 -0.13 0.13" mass="6"/>

          <!--
            TAIL HANDLE:
              Ossified caudals → LATERAL SWING ONLY [Arbour 2009]
              1 DOF only: tail_handle_lat (±60°)
              High gear=600: this is the strike weapon
              Whip-crack: proximal-to-distal energy transfer mechanism
          -->
          <body name="tail_handle" pos="-0.60 0 -0.04">
            <joint name="tail_handle_lat" type="hinge" axis="0 0 1"
                   range="-60 60" damping="2.0" stiffness="5"/>
            <geom name="tail_handle_geom" type="capsule"
                  fromto="0 0 0  -0.58 0 0"
                  size="0.09" mass="28" rgba="0.48 0.40 0.26 1"/>

            <!--
              TAIL CLUB (knob): RIGID, no joints — fused to handle
              Sphere r=0.22m, mass=30kg [ARBOUR2009 large knob]
              contype=4/conaffinity=4: interacts with T-rex (set T-rex to same)
            -->
            <body name="tail_club" pos="-0.58 0 0">
              <geom class="club" name="club_knob" type="sphere"
                    size="0.22" mass="30"/>
              <geom class="armor" name="club_plate_L" type="box"
                    size="0.11 0.09 0.05" pos="0 0.20 0" mass="6"/>
              <geom class="armor" name="club_plate_R" type="box"
                    size="0.11 0.09 0.05" pos="0 -0.20 0" mass="6"/>
              <site name="club_site" pos="0 0 0" size="0.23" type="sphere"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ============================================== -->
      <!-- LEGS — WIDE-GAUGE QUADRUPED                  -->
      <!--                                              -->
      <!-- Hip attachment at y=±0.75 (wide-gauge)       -->
      <!-- Femur angles DOWN-AND-OUT (not columnar)     -->
      <!-- 5 DOF per leg × 4 legs = 20 DOF total        -->
      <!--                                              -->
      <!-- Joint ranges from:                           -->
      <!--   - Acetabulum orientation (fossil)          -->
      <!--   - Wide-gauge trackway stride analysis      -->
      <!--   - Elephant/rhino comparative biomechanics  -->
      <!-- ============================================== -->

      <!-- FRONT LEFT -->
      <body name="hip_FL" pos="0.88  0.75 -0.22">
        <joint name="hip_FL_abduct" type="hinge" axis="1 0 0"
               range="-15 15" damping="10.0" stiffness="30"/>
        <joint name="hip_FL_flex"   type="hinge" axis="0 1 0"
               range="-40 60" damping="10.0" stiffness="20"/>
        <joint name="hip_FL_rotate" type="hinge" axis="0 0 1"
               range="-20 20" damping="6.0"  stiffness="15"/>
        <geom class="leg" name="femur_FL" type="capsule"
              fromto="0 0 0  0.10 0.14 -0.44" size="0.085" mass="65"/>
        <body name="knee_FL" pos="0.10 0.14 -0.44">
          <joint name="knee_FL" type="hinge" axis="0 1 0"
                 range="-5 120" damping="6.0" stiffness="15"/>
          <geom class="leg" name="tibia_FL" type="capsule"
                fromto="0 0 0  0.04 0.05 -0.38" size="0.065" mass="32"/>
          <body name="ankle_FL" pos="0.04 0.05 -0.38">
            <joint name="ankle_FL" type="hinge" axis="0 1 0"
                   range="-35 35" damping="3.5" stiffness="10"/>
            <geom class="leg" name="foot_FL" type="capsule"
                  fromto="0 0 0  0.14 0 -0.09" size="0.055" mass="16"/>
            <geom class="leg" name="toe_FL" type="sphere"
                  size="0.065" pos="0.14 0 -0.09" mass="5"/>
            <site name="foot_FL_site" pos="0.07 0 -0.09" size="0.04"/>
          </body>
        </body>
      </body>

      <!-- FRONT RIGHT -->
      <body name="hip_FR" pos="0.88 -0.75 -0.22">
        <joint name="hip_FR_abduct" type="hinge" axis="1 0 0"
               range="-15 15" damping="10.0" stiffness="30"/>
        <joint name="hip_FR_flex"   type="hinge" axis="0 1 0"
               range="-40 60" damping="10.0" stiffness="20"/>
        <joint name="hip_FR_rotate" type="hinge" axis="0 0 1"
               range="-20 20" damping="6.0"  stiffness="15"/>
        <geom class="leg" name="femur_FR" type="capsule"
              fromto="0 0 0  0.10 -0.14 -0.44" size="0.085" mass="65"/>
        <body name="knee_FR" pos="0.10 -0.14 -0.44">
          <joint name="knee_FR" type="hinge" axis="0 1 0"
                 range="-5 120" damping="6.0" stiffness="15"/>
          <geom class="leg" name="tibia_FR" type="capsule"
                fromto="0 0 0  0.04 -0.05 -0.38" size="0.065" mass="32"/>
          <body name="ankle_FR" pos="0.04 -0.05 -0.38">
            <joint name="ankle_FR" type="hinge" axis="0 1 0"
                   range="-35 35" damping="3.5" stiffness="10"/>
            <geom class="leg" name="foot_FR" type="capsule"
                  fromto="0 0 0  0.14 0 -0.09" size="0.055" mass="16"/>
            <geom class="leg" name="toe_FR" type="sphere"
                  size="0.065" pos="0.14 0 -0.09" mass="5"/>
            <site name="foot_FR_site" pos="0.07 0 -0.09" size="0.04"/>
          </body>
        </body>
      </body>

      <!-- REAR LEFT (slightly larger — hindlimbs bear more load) -->
      <body name="hip_RL" pos="-0.78  0.75 -0.20">
        <joint name="hip_RL_abduct" type="hinge" axis="1 0 0"
               range="-15 15" damping="11.0" stiffness="35"/>
        <joint name="hip_RL_flex"   type="hinge" axis="0 1 0"
               range="-40 60" damping="11.0" stiffness="22"/>
        <joint name="hip_RL_rotate" type="hinge" axis="0 0 1"
               range="-20 20" damping="7.0"  stiffness="18"/>
        <geom class="leg" name="femur_RL" type="capsule"
              fromto="0 0 0  -0.08 0.14 -0.46" size="0.092" mass="72"/>
        <body name="knee_RL" pos="-0.08 0.14 -0.46">
          <joint name="knee_RL" type="hinge" axis="0 1 0"
                 range="-5 120" damping="7.0" stiffness="18"/>
          <geom class="leg" name="tibia_RL" type="capsule"
                fromto="0 0 0  -0.04 0.05 -0.40" size="0.070" mass="36"/>
          <body name="ankle_RL" pos="-0.04 0.05 -0.40">
            <joint name="ankle_RL" type="hinge" axis="0 1 0"
                   range="-35 35" damping="4.0" stiffness="12"/>
            <geom class="leg" name="foot_RL" type="capsule"
                  fromto="0 0 0  -0.12 0 -0.09" size="0.060" mass="18"/>
            <geom class="leg" name="toe_RL" type="sphere"
                  size="0.070" pos="-0.12 0 -0.09" mass="6"/>
            <site name="foot_RL_site" pos="-0.06 0 -0.09" size="0.04"/>
          </body>
        </body>
      </body>

      <!-- REAR RIGHT -->
      <body name="hip_RR" pos="-0.78 -0.75 -0.20">
        <joint name="hip_RR_abduct" type="hinge" axis="1 0 0"
               range="-15 15" damping="11.0" stiffness="35"/>
        <joint name="hip_RR_flex"   type="hinge" axis="0 1 0"
               range="-40 60" damping="11.0" stiffness="22"/>
        <joint name="hip_RR_rotate" type="hinge" axis="0 0 1"
               range="-20 20" damping="7.0"  stiffness="18"/>
        <geom class="leg" name="femur_RR" type="capsule"
              fromto="0 0 0  -0.08 -0.14 -0.46" size="0.092" mass="72"/>
        <body name="knee_RR" pos="-0.08 -0.14 -0.46">
          <joint name="knee_RR" type="hinge" axis="0 1 0"
                 range="-5 120" damping="7.0" stiffness="18"/>
          <geom class="leg" name="tibia_RR" type="capsule"
                fromto="0 0 0  -0.04 -0.05 -0.40" size="0.070" mass="36"/>
          <body name="ankle_RR" pos="-0.04 -0.05 -0.40">
            <joint name="ankle_RR" type="hinge" axis="0 1 0"
                   range="-35 35" damping="4.0" stiffness="12"/>
            <geom class="leg" name="foot_RR" type="capsule"
                  fromto="0 0 0  -0.12 0 -0.09" size="0.060" mass="18"/>
            <geom class="leg" name="toe_RR" type="sphere"
                  size="0.070" pos="-0.12 0 -0.09" mass="6"/>
            <site name="foot_RR_site" pos="-0.06 0 -0.09" size="0.04"/>
          </body>
        </body>
      </body>

    </body><!-- end torso -->
  </worldbody>

  <actuator>
    <!-- Neck + head -->
    <motor name="act_neck_pitch"  joint="neck_pitch"  gear="180"/>
    <motor name="act_neck_yaw"    joint="neck_yaw"    gear="180"/>
    <motor name="act_head_pitch"  joint="head_pitch"  gear=" 90"/>

    <!-- Front Left -->
    <motor name="act_hip_FL_abduct" joint="hip_FL_abduct" gear="520"/>
    <motor name="act_hip_FL_flex"   joint="hip_FL_flex"   gear="850"/>
    <motor name="act_hip_FL_rotate" joint="hip_FL_rotate" gear="320"/>
    <motor name="act_knee_FL"       joint="knee_FL"       gear="650"/>
    <motor name="act_ankle_FL"      joint="ankle_FL"      gear="220"/>

    <!-- Front Right -->
    <motor name="act_hip_FR_abduct" joint="hip_FR_abduct" gear="520"/>
    <motor name="act_hip_FR_flex"   joint="hip_FR_flex"   gear="850"/>
    <motor name="act_hip_FR_rotate" joint="hip_FR_rotate" gear="320"/>
    <motor name="act_knee_FR"       joint="knee_FR"       gear="650"/>
    <motor name="act_ankle_FR"      joint="ankle_FR"      gear="220"/>

    <!-- Rear Left (higher torque) -->
    <motor name="act_hip_RL_abduct" joint="hip_RL_abduct" gear="580"/>
    <motor name="act_hip_RL_flex"   joint="hip_RL_flex"   gear="950"/>
    <motor name="act_hip_RL_rotate" joint="hip_RL_rotate" gear="370"/>
    <motor name="act_knee_RL"       joint="knee_RL"       gear="720"/>
    <motor name="act_ankle_RL"      joint="ankle_RL"      gear="260"/>

    <!-- Rear Right -->
    <motor name="act_hip_RR_abduct" joint="hip_RR_abduct" gear="580"/>
    <motor name="act_hip_RR_flex"   joint="hip_RR_flex"   gear="950"/>
    <motor name="act_hip_RR_rotate" joint="hip_RR_rotate" gear="370"/>
    <motor name="act_knee_RR"       joint="knee_RR"       gear="720"/>
    <motor name="act_ankle_RR"      joint="ankle_RR"      gear="260"/>

    <!-- Tail (gear increases toward club for whip-crack dynamics) -->
    <motor name="act_tail_base_lat"   joint="tail_base_lat"   gear="420"/>
    <motor name="act_tail_base_dv"    joint="tail_base_dv"    gear="320"/>
    <motor name="act_tail_mid_lat"    joint="tail_mid_lat"    gear="340"/>
    <motor name="act_tail_mid_dv"     joint="tail_mid_dv"     gear="240"/>
    <!-- Handle: HIGH gear — strike weapon. Arbour 2009: up to 14,360 N impact -->
    <motor name="act_tail_handle_lat" joint="tail_handle_lat" gear="600"/>
  </actuator>

  <sensor>
    <!-- IMU sensors at indices 0–9 (matching BaseDinoEnv defaults) -->
    <!-- gyro: indices 0-2, accel: indices 3-5, quat: indices 6-9  -->
    <gyro        name="torso_gyro"   site="imu"/>
    <accelerometer name="torso_accel" site="imu"/>
    <framequat   name="torso_quat"   objtype="site" objname="imu"/>

    <!-- Foot contact touch sensors: indices 10-13 -->
    <touch name="touch_FL" site="foot_FL_site"/>
    <touch name="touch_FR" site="foot_FR_site"/>
    <touch name="touch_RL" site="foot_RL_site"/>
    <touch name="touch_RR" site="foot_RR_site"/>

    <!-- Club strike sensor: index 14 -->
    <touch name="touch_club" site="club_site"/>

    <!-- Joint positions (28 dims): indices 15-42 -->
    <jointpos name="pos_neck_pitch"     joint="neck_pitch"/>
    <jointpos name="pos_neck_yaw"       joint="neck_yaw"/>
    <jointpos name="pos_head_pitch"     joint="head_pitch"/>
    <jointpos name="pos_hip_FL_ab"      joint="hip_FL_abduct"/>
    <jointpos name="pos_hip_FL_fl"      joint="hip_FL_flex"/>
    <jointpos name="pos_hip_FL_ro"      joint="hip_FL_rotate"/>
